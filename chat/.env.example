# mock — фейковый собеседник без Telegram (dev); telegram — настоящий бот
CHAT_MODE=mock
# DEV — long polling; иначе вебхук (WEBHOOK_URL + WEBHOOK_SECRET)
ENV=DEV
BOT_TOKEN=
# id Telegram-группы, с которой синхронизируется Live-чат
CHAT_ID=
# юзернейм бота без @: такой ник на сайте будет занят
BOT_USERNAME=
# вне DEV: публичный URL вебхука и секрет; сервер вебхука слушает WEBHOOK_PORT
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_PORT=8081
# 1 — показывать на сайте фото и стикеры из группы, 0 — только подписи [фото]/[стикер]
SHOW_MEDIA=1
# без REDIS_URL всё хранится в памяти процесса
REDIS_URL=
# соль для хэша IP и ключ подписи пропуска капчи — длинные случайные строки
IP_HASH_SALT=
PASS_SECRET=
# за nginx: брать адрес из X-Real-IP (без этого заголовкам не верим)
TRUST_PROXY=
# сессия ghoul_quiz владельца (ghoul-quiz-register); без неё капча идёт по фикстуре
GHOUL_QUIZ_EMAIL=
GHOUL_QUIZ_TOKEN_PATH=
GHOUL_QUIZ_API_URL=https://chestor.site/api
# вопросы капчи без сессии владельца
QUIZ_FIXTURE_PATH=
